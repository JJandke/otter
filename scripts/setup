#!/bin/sh
set -eu
umask 077
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"
if ! command -v uv >/dev/null 2>&1; then
  echo 'Install uv using https://docs.astral.sh/uv/getting-started/installation/ then rerun.' >&2
  exit 6
fi
if test -e .venv; then
  if ! test -x .venv/bin/python || ! .venv/bin/python -c 'import sys; sys.exit(sys.version_info[:3] != (3, 14, 7))'; then
    echo 'The existing .venv is not Python 3.12.14; review it locally before replacing it.' >&2
    exit 6
  fi
else
  uv venv --python 3.12.14
fi
uv pip sync --python .venv/bin/python requirements.lock
.venv/bin/python -m playwright install chromium
git config --local core.hooksPath .githooks
echo 'Environment ready. Run ./scripts/m1 login to authenticate in the dedicated browser.'
